# ── Auth.js ────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# The canonical URL of the app (used by Auth.js for callback URLs).
# On Cloudflare Pages this is inferred automatically; set explicitly if needed.
# AUTH_URL=https://mein.typ2-kompass.de

# ── Resend (transactional email for magic links) ────────────────────────────────
# Sign up at https://resend.com – free tier covers dev / early prod.
# Use an EU-region sending domain to stay within GDPR-friendly infrastructure.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# From-address that appears in the magic-link email. Must be a verified Resend
# domain. Example: "Typ2-Kompass <no-reply@mein.typ2-kompass.de>"
EMAIL_FROM=Typ2-Kompass <no-reply@mein.typ2-kompass.de>

# ── Cloudflare D1 (database – local dev only) ──────────────────────────────────
# The D1 binding (DB) is injected automatically in the Cloudflare Pages runtime
# via wrangler.toml. The variables below are only needed for tooling outside the
# worker (e.g. running migrations against a local SQLite preview).
#
# See README.md §Datenbank for provisioning steps.

# ── Plausible (product analytics, EU region) ───────────────────────────────────
# Domain registered in the Plausible site config; controls the script's
# `data-domain` and where events are routed. Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=mein.typ2-kompass.de

# Plausible API key — server-only, used for server-side custom events
# (e.g. signup_completed from the magic-link callback). Never expose to client.
PLAUSIBLE_API_KEY=

# ── Sentry (error reporting, EU data residency) ────────────────────────────────
# Public DSN — safe to ship to the client. Empty value disables Sentry at runtime.
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only. Used by the Sentry webpack plugin to upload source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=typ2-kompass-web

# Random secret that gates the `/dev-throw` page (client-side) and the
# `/api/dev-throw` route (server-side / Workers logs) used to verify
# error reporting end-to-end. NEXT_PUBLIC_ because the client throw page
# must read it from the browser bundle. Generate with: openssl rand -hex 16
NEXT_PUBLIC_DEBUG_THROW_KEY=
